      "priority": "P0",
      "trigger": "always_on",
      "version": "2.7.0"
    },
    "dynamic-routing": {
      "description": "Phân loại Mode (Fast/Targeted/Deep/Refactor/Audit/Compression) và Capability Bundle dưới sự điều phối của Kit Architect.",
      "path": "rules/dynamic-routing.md",
      "priority": "P1",
      "trigger": "always_on",
      "version": "2.5.0"
    }
