{
  "$schema": "schemas/manifest.schema.json",
  "agents": {
    "kit-architect": {
      "model": "inherit",
      "path": "agent/kit-architect.md",
      "requires": {
        "skills": {
          "domain-profiling": "^2.2.0",
          "kit-assembling": "^2.2.0",
          "kit-evolving": "^2.0.0",
          "kit-exporting": "^2.0.0",
          "kit-verifying": "^2.2.0",
          "prompt-compiling": "^2.2.0",
          "skill-architecting": "^2.2.0"
        }
      },
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash",
        "Edit",
        "Write"
      ],
      "version": "2.0.0"
    }
  },
  "contracts": {
    "componentApi": "1.0.0",
    "memorySchema": "1.0.0",
    "rulesApi": "1.0.0",
    "workflowApi": "1.0.0"
  },
  "kitVersion": "2026.8.17",
  "rules": {
    "core-guardrails": {
      "path": "rules/core-guardrails.md",
      "priority": "P0",
      "trigger": "always_on",
      "version": "2.0.0"
    },
    "dynamic-routing": {
