    "collaboration-protocol": {
      "description": "Giao thức cộng tác & điều phối hệ thống: Mandatory Grounding Gate, Truthful Status HUD Protocol, 3-Layer Cognitive Context, High-Automation Auto-Transition và Anti-Approval Fatigue.",
      "path": "rules/collaboration-protocol.md",
      "priority": "P0",
      "trigger": "always_on",
      "version": "1.0.0"
    },
    "core-guardrails": {
      "description": "Core guardrails: workspace isolation, targeted grounding, sequential execution, verification feasibility.",
