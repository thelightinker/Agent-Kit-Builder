    "create-kit": {
      "artifactOutputs": [
        "domain_profile",
        "system_prompt",
        "skill_manifest",
        "validation_report"
      ],
      "path": "workflows/create-kit.md",
      "requires": {
        "agents": [
          "kit-architect"
        ],
        "skills": [
          "domain-profiling",
          "prompt-compiling",
          "skill-architecting",
          "kit-assembling",
          "kit-verifying"
        ]
      },
      "version": "2.1.0"
    },
    "refactor-kit": {
