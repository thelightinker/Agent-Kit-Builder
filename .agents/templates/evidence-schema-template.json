{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompiledEvidenceSchemas",
  "description": "Mapping of capability IDs to their executable structural and semantic evidence validation schemas.",
  "type": "object",
  "required": ["version", "generated_at", "schemas"],
  "properties": {
    "version": { "type": "string" },
    "generated_at": { "type": "string" },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["structural", "semantic"],
        "properties": {
          "structural": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["check"],
              "properties": {
                "check": { "type": "string" },
                "path": { "type": "string" },
                "min_value": { "type": "number" },
                "metric": { "type": "string" }
              }
            }
          },
          "semantic": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "evaluator"],
              "properties": {
                "name": { "type": "string" },
                "evaluator": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
