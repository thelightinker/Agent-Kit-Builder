{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag-kit.local/schemas/manifest.schema.json",
  "title": "Agent Kit Component Manifest Schema",
  "type": "object",
  "required": ["schemaVersion", "kitVersion", "agents", "skills", "workflows", "rules"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "kitVersion": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]+\\.[0-9]+$" },
    "contracts": { "type": "object", "additionalProperties": { "type": "string" } },
    "support": { "type": "object" },
    "artifact_contracts": {
      "type": "object",
      "properties": {
        "consumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "preferred_sources": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "produces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "path_pattern"],
            "properties": {
              "type": { "type": "string" },
              "default_scope": { "type": "string", "enum": ["project", "shared"] },
              "path_pattern": { "type": "string" },
              "promotable_to": { "type": "string" }
            }
          }
        },
        "workspace_dir": { "type": "string", "default": ".workspace" }
      }
    },
    "agents": { "type": "object", "additionalProperties": { "$ref": "#/$defs/component" } },
    "skills": { "type": "object", "additionalProperties": { "$ref": "#/$defs/component" } },
    "workflows": { "type": "object", "additionalProperties": { "$ref": "#/$defs/component" } },
    "rules": { "type": "object", "additionalProperties": { "$ref": "#/$defs/ruleComponent" } }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["path", "version"],
      "properties": {
        "path": { "type": "string" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }
      },
      "additionalProperties": true
    },
    "ruleComponent": {
      "type": "object",
      "required": ["path", "version", "priority", "trigger"],
      "properties": {
        "path": { "type": "string" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
        "trigger": { "type": "string", "enum": ["always_on", "manual", "model_decision"] },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
