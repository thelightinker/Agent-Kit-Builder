{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antigravity Runtime Contract Schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "runtime",
    "phases"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "runtime": {
      "type": "string",
      "enum": ["antigravity"]
    },
    "requiredCliCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phases": {
      "type": "object",
      "required": [
        "discovery",
        "mcp",
        "hooks",
        "orchestration",
        "plugin",
        "validation"
      ],
      "properties": {
        "discovery": {
          "type": "object",
          "required": ["rules", "skills", "workflows"],
          "properties": {
            "rules": { "type": "string" },
            "skills": { "type": "string" },
            "workflows": { "type": "string" }
          }
        },
        "mcp": {
          "type": "object",
          "required": ["workspaceConfig"],
          "properties": {
            "workspaceConfig": { "type": "string" },
            "suiteGlobalConfig": { "type": "string" },
            "cliGlobalConfig": { "type": "string" }
          }
        },
        "hooks": {
          "type": "object",
          "required": ["config", "policy"],
          "properties": {
            "config": { "type": "string" },
            "policy": { "type": "string" }
          }
        },
        "orchestration": {
          "type": "object",
          "required": ["workflows", "agents", "skills"],
          "properties": {
            "workflows": {
              "type": "array",
              "items": { "type": "string" }
            },
            "agents": {
              "type": "array",
              "items": { "type": "string" }
            },
            "skills": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "plugin": {
          "type": "object",
          "required": ["builder", "defaultOutput"],
          "properties": {
            "builder": { "type": "string" },
            "defaultOutput": { "type": "string" }
          }
        },
        "validation": {
          "type": "object",
          "required": ["doctor", "tests"],
          "properties": {
            "doctor": { "type": "string" },
            "tests": { "type": "string" }
          }
        }
      }
    }
  }
}
