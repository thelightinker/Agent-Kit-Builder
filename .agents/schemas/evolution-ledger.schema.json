{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvolutionLedger",
  "type": "object",
  "required": [
    "schema_version",
    "kit_id",
    "current_canonical_version",
    "lineage",
    "evolution_runs",
    "feedback_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["2.0.0"]
    },
    "kit_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "current_canonical_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lineage": {
      "type": "object",
      "required": ["created_at", "last_evolved_at", "total_evolution_cycles"],
      "properties": {
        "created_at": { "type": "string" },
        "last_evolved_at": { "type": "string" },
        "total_evolution_cycles": { "type": "integer", "minimum": 0 }
      }
    },
    "evolution_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "from_version",
          "to_version",
          "triggered_by_batch",
          "risk_tier",
          "human_approval",
          "snapshot_ref",
          "feedbacks_addressed",
          "verification_evidence"
        ],
        "properties": {
          "run_id": { "type": "string" },
          "from_version": { "type": "string" },
          "to_version": { "type": "string" },
          "triggered_by_batch": { "type": "string" },
          "risk_tier": {
            "type": "string",
            "enum": ["TIER_0_LOW", "TIER_1_STANDARD", "TIER_2_ARCHITECTURAL"]
          },
          "human_approval": {
            "type": "object",
            "required": ["required", "approved_by", "approved_at"],
            "properties": {
              "required": { "type": "boolean" },
              "approved_by": { "type": ["string", "null"] },
              "approved_at": { "type": ["string", "null"] }
            }
          },
          "snapshot_ref": { "type": "string" },
          "feedbacks_addressed": {
            "type": "array",
            "items": { "type": "string" }
          },
          "verification_evidence": {
            "type": "object",
            "required": ["l1_linter_pass", "linter_command", "linter_score", "error_count", "log_snippet"],
            "properties": {
              "l1_linter_pass": { "type": "boolean" },
              "linter_command": { "type": "string" },
              "linter_score": { "type": "integer", "minimum": 0, "maximum": 5 },
              "error_count": { "type": "integer", "minimum": 0 },
              "log_snippet": { "type": "string" }
            }
          }
        }
      }
    },
    "feedback_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feedback_id",
          "batch_id",
          "source_version",
          "cluster_key",
          "category",
          "status",
          "received_at"
        ],
        "properties": {
          "feedback_id": { "type": "string" },
          "batch_id": { "type": "string" },
          "source_version": { "type": "string" },
          "cluster_key": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["failure", "friction", "idea"]
          },
          "status": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "TRIAGED",
              "REJECTED",
              "DIAGNOSED",
              "PATCHED",
              "VERIFIED",
              "RELEASED"
            ]
          },
          "received_at": { "type": "string" },
          "diagnosed_root_cause": { "type": "string" },
          "resolved_in_run_id": { "type": "string" },
          "resolved_in_version": { "type": "string" },
          "impacted_files": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
