{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentKitLifecycleState",
  "type": "object",
  "required": [
    "schema_version",
    "kit_name",
    "kit_version",
    "lifecycle_state",
    "active_change_gate",
    "lineage",
    "verdicts",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "kit_name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "kit_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY_FOR_VALIDATION",
        "VALIDATED",
        "NEEDS_REFACTOR",
        "NEEDS_HUMAN_INTERVENTION",
        "EXEMPLAR_ARCHIVED"
      ]
    },
    "active_change_gate": {
      "type": ["string", "null"],
      "enum": [null, "architecture_evolution", "manual_audit"]
    },
    "lineage": {
      "type": "object",
      "required": ["created_at", "updated_at", "created_by", "repair_cycle_count", "max_repair_cycles"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "enum": ["create-kit", "manual_scaffold"] },
        "repair_cycle_count": { "type": "integer", "minimum": 0 },
        "max_repair_cycles": { "type": "integer", "default": 3 }
      }
    },
    "verdicts": {
      "type": "object",
      "required": ["validation", "memory_promotion"],

      "properties": {
        "validation": {
          "type": "object",
          "required": ["pass", "score", "findings_file", "last_validated_at"],
          "properties": {
            "pass": { "type": "boolean" },
            "score": { "type": "integer", "minimum": 0, "maximum": 5 },
            "findings_file": { "type": ["string", "null"] },
            "last_validated_at": { "type": ["string", "null"] }
          }
        },
        "visual_qa": {
          "type": "object",
          "required": ["evidence_file", "last_checked_at"],
          "properties": {
            "evidence_file": { "type": ["string", "null"] },
            "last_checked_at": { "type": ["string", "null"] }
          }
        },
        "memory_promotion": {
          "type": "object",
          "required": ["promoted", "promoted_at", "memory_ref"],
          "properties": {
            "promoted": { "type": "boolean" },
            "promoted_at": { "type": ["string", "null"] },
            "memory_ref": { "type": ["string", "null"] }
          }
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": ["contract_version", "source_workflow", "target_workflow", "payload_file", "evidence_refs", "notes"],
      "properties": {
        "contract_version": { "type": "string", "enum": ["1.0.0"] },
        "source_workflow": { "type": "string" },
        "target_workflow": { "type": "string" },
        "payload_file": { "type": ["string", "null"] },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
