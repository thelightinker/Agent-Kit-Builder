{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SnapshotManifest",
  "type": "object",
  "required": [
    "schema_version",
    "kit_name",
    "version",
    "created_at",
    "root_hash",
    "total_files",
    "total_bytes",
    "tree_checksum"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "kit_name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "root_hash": {
      "type": "string"
    },
    "total_files": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "tree_checksum": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
